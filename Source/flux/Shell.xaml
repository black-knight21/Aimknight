<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AimKnight" Width="1320" Height="880" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#000000" Foreground="#F0EDE6" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#D4AF37"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0EDE6"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F0EDE6"/><Setter Property="Background" Value="#181820"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D4AF37"/><Setter Property="Foreground" Value="#000000"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#09090F"/><Setter Property="Foreground" Value="#F0EDE6"/><Setter Property="CaretBrush" Value="#F4D06F"/><Setter Property="BorderBrush" Value="#382F18"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="SelectionBrush" Value="#D4AF37"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#09090F"/><Setter Property="Foreground" Value="#F0EDE6"/><Setter Property="BorderBrush" Value="#382F18"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#D4AF37"/><Setter Property="Margin" Value="0,3,0,5"/><Setter Property="Height" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center"><Track x:Name="PART_Track" Height="16" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#D4AF37" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#262218" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F4D06F" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#6E5B24" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0D0D14"/><Setter Property="BorderBrush" Value="#2A2516"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#8A8A98"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Border CornerRadius="6" BorderBrush="#4D3F18" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.Background><SolidColorBrush Color="#000000"/></Grid.Background>
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Margin="22,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#000000" BorderBrush="#D4AF37" BorderThickness="1" Width="30" Height="30" CornerRadius="6"><Viewbox Width="20" Height="20"><Canvas Width="100" Height="100"><Path Stroke="#F0EDE6" StrokeThickness="7" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter" Data="M46,12 H16 V63 L46,88 M46,12 V38 M16,12 L50,44 L84,12 M27,29 V58 L46,74 V50 L32,37 M27,45 L36,36 M54,12 H84 V63 L54,88 V49 L76,29 M54,12 V38 M63,41 L81,60"/></Canvas></Viewbox></Border><TextBlock Text="AIM" FontSize="13" FontWeight="Bold" Foreground="#F0EDE6" Margin="12,0,4,0" VerticalAlignment="Center"/><TextBlock Text="KNIGHT" FontSize="13" Foreground="#D4AF37" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="—" Background="Transparent" Padding="15,8"/><Button x:Name="Maximize" Content="□" Background="Transparent" Padding="15,8"/><Button x:Name="CloseApp" Content="✕" Background="Transparent" Padding="15,8"/></StackPanel></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#1E1C24" BorderThickness="0,0,1,0" Padding="16,24,16,18"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#14120C" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="AIMKNIGHT" Foreground="#D4AF37" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Mouse acceleration configuration" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border><Button x:Name="Licenses" Content="Licenses" Background="Transparent" Foreground="#8A8A98" Padding="10,6"/></StackPanel><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Muted}" Margin="14,0,0,15"/><Button x:Name="NavOverview" Content="◈   Overview" Style="{StaticResource Nav}" Background="#241F12"/><Button x:Name="NavAim" Content="   Aim practice" Style="{StaticResource Nav}"/><Button x:Name="NavLibrary" Content="▤   Curve library" Style="{StaticResource Nav}"/><Button x:Name="NavMouse" Content="◎   Mouse setup" Style="{StaticResource Nav}"/><Border Height="1" Background="#26232E" Margin="12,22"/><TextBlock x:Name="SidebarMouse" Text="Your setup" FontWeight="SemiBold" Margin="14,0,0,7"/><TextBlock x:Name="SidebarInfo" Text="Complete your setup" Style="{StaticResource Muted}" Margin="14,0,0,0"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1" Margin="30,18,30,20"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Current settings and pending changes." Foreground="#8A8A98" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C2A25" CornerRadius="16" Padding="14,8"><TextBlock x:Name="DriverBadge" Text="●  Checking driver" Foreground="#8DDAB2" FontSize="12"/></Border></Grid>
     <Grid x:Name="Overview" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
      <UniformGrid Columns="3" Margin="0,0,-14,16"><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="MOUSE DPI" Style="{StaticResource Muted}"/><TextBlock x:Name="DpiMetric" Text="1,600" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="POLLING RATE" Style="{StaticResource Muted}"/><TextBlock x:Name="PollMetric" Text="Automatic" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="CURRENT CURVE" Style="{StaticResource Muted}"/><TextBlock x:Name="CurveMetric" Text="Classic" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
      <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Acceleration curve" FontSize="16" FontWeight="SemiBold"/><Border Background="#241F12" CornerRadius="7" Padding="8,4" Margin="12,-2,0,0" VerticalAlignment="Top"><TextBlock x:Name="PreviewTag" Text="LIVE" FontSize="10" Foreground="#F4D06F"/></Border></StackPanel><Canvas x:Name="CurveCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"/><Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Slow aim" Style="{StaticResource Muted}"/><TextBlock x:Name="CurveAxis" Text="Input speed →" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="Fast flick" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid></Grid></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="ApplyCurve" Content="Apply changes" Style="{StaticResource Primary}" Margin="0,10,0,0"/><Button x:Name="DiscardCurve" Content="Discard preview" Background="Transparent" Padding="12,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Fine tune" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Changes stay in preview until applied." Style="{StaticResource Muted}" Margin="0,5,0,14"/><Grid><TextBlock Text="Base sensitivity"/><TextBlock x:Name="SensValue" HorizontalAlignment="Right" Foreground="#F4D06F"/></Grid><Slider x:Name="SensSlider" Minimum="0.1" Maximum="3" Value="1" SmallChange="0.05"/><Grid><TextBlock Text="Acceleration"/><TextBlock x:Name="AccelValue" HorizontalAlignment="Right" Foreground="#F4D06F"/></Grid><Slider x:Name="AccelSlider" Minimum="0" Maximum="1" Value="0.3" SmallChange="0.01"/><Grid><TextBlock Text="Input offset"/><TextBlock x:Name="OffsetValue" HorizontalAlignment="Right" Foreground="#F4D06F"/></Grid><Slider x:Name="OffsetSlider" Minimum="0" Maximum="20" Value="2" SmallChange="0.25"/><Grid><TextBlock Text="Output cap"/><TextBlock x:Name="CapValue" HorizontalAlignment="Right" Foreground="#F4D06F"/></Grid><Slider x:Name="CapSlider" Minimum="1" Maximum="5" Value="2" SmallChange="0.1"/></StackPanel></ScrollViewer></DockPanel></Border>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Aim Practice" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Test reaction time, flick speed, and precision tracking." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="1" x:Name="OpenPractice" Content="Start Practice" VerticalAlignment="Center" Background="#241F12" Padding="14,12"/></Grid></Border>
<Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Curve library" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Save and restore curve configurations." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="QuickSave" Content="Save curve" Padding="14,8"/><Button x:Name="QuickUndo" Content="Undo last apply" Background="Transparent" Padding="10,8"/></StackPanel></Grid></Border></Grid>
     </Grid>
     <Grid x:Name="AIPage" Grid.Row="1" Visibility="Collapsed" />
     <ScrollViewer x:Name="LibraryPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="A starting point for every style." Foreground="#8A8A98" Margin="0,5,0,20"/><UniformGrid Columns="3" Margin="0,0,-14,24"><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="01 / PRECISION" Foreground="#D4AF37" FontSize="11"/><TextBlock Text="Quiet aim" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="A gentle lift with a restrained output cap." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetQuiet" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="02 / EVERYDAY" Foreground="#D4AF37" FontSize="11"/><TextBlock Text="Balanced" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="Measured acceleration for aim and movement." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetBalanced" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="03 / MOTION" Foreground="#D4AF37" FontSize="11"/><TextBlock Text="Flick boost" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="More reach when you make a fast movement." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetFlick" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Your saved curves" FontSize="18" FontWeight="SemiBold"/><Button x:Name="SaveLibrary" Content="Save current curve" HorizontalAlignment="Right"/></Grid><StackPanel x:Name="SavedCurves" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="230,0,28,0"><TextBlock x:Name="Status" Text="Ready." Foreground="#8A8A98" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="AIMKNIGHT  /  0.3.4" Foreground="#8A8A98" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Border x:Name="WizardOverlay" Grid.RowSpan="3" Background="#050508" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Border Margin="58,86,40,70" CornerRadius="26" Padding="40"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C170C" Offset="0"/><GradientStop Color="#0A0A0F" Offset="1"/></LinearGradientBrush></Border.Background><Grid><StackPanel VerticalAlignment="Top"><TextBlock Text="A / K" Foreground="#D4AF37" FontSize="18" FontWeight="Bold"/><TextBlock Text="Better aim.&#10;Your way." FontSize="48" FontWeight="SemiBold" Margin="0,54,0,22"/><TextBlock Text="A little setup. A completely personal feel." Foreground="#F0EDE6" FontSize="17" TextWrapping="Wrap"/><Canvas Height="180" Margin="0,30,0,0"><Path Stroke="#D4AF37" StrokeThickness="4" Data="M 0,155 C 70,155 90,148 140,110 S 230,38 310,20"/><Path Stroke="#4D3F18" StrokeThickness="1" Data="M 0,176 L 310,176 M 0,128 L 310,128 M 0,80 L 310,80 M 0,32 L 310,32"/></Canvas></StackPanel><TextBlock Text="Your setup is saved on this PC.&#10;Change it anytime from Mouse setup." Style="{StaticResource Muted}" VerticalAlignment="Bottom"/></Grid></Border><Grid Grid.Column="1" Margin="42,95,76,90"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions><Grid><TextBlock x:Name="WizardCount" Text="01 / 09" Foreground="#D4AF37" FontSize="12"/><Button x:Name="WizardClose" Content="✕" HorizontalAlignment="Right" Background="Transparent" Padding="8,0"/></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="WizardEyebrow" Text="WELCOME TO AIMKNIGHT" Foreground="#D4AF37" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="WizardTitle" Text="Let's get connected." FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="WizardDescription" Text="" Foreground="#8A8A98" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,26"/><StackPanel x:Name="WizardFields"/><TextBlock x:Name="WizardError" Foreground="#F0A8BA" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel><Grid Grid.Row="2"><Button x:Name="WizardBack" Content="← Back" HorizontalAlignment="Left" Background="Transparent"/><Button x:Name="WizardNext" Content="Continue →" HorizontalAlignment="Right" Style="{StaticResource Primary}"/></Grid></Grid></Grid></Border>
  </Grid>
 </Border>
</Window>
