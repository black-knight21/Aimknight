<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kaiden Flux" Width="1320" Height="880" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#141419" Foreground="#ECEBF0" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#A898CA"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECEBF0"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDE5FF"/><Setter Property="Background" Value="#2B2932"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#A898CA"/><Setter Property="Foreground" Value="#130D24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#130F21"/><Setter Property="Foreground" Value="#F1EAFF"/><Setter Property="CaretBrush" Value="#C4AEFF"/><Setter Property="BorderBrush" Value="#35294E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="SelectionBrush" Value="#7752BE"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#130F21"/><Setter Property="Foreground" Value="#F1EAFF"/><Setter Property="BorderBrush" Value="#35294E"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#B89AFF"/><Setter Property="Margin" Value="0,3,0,5"/><Setter Property="Height" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center"><Track x:Name="PART_Track" Height="16" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#9470D1" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#3B2B50" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#D2B8FF" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5A3F73" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1D1D24"/><Setter Property="BorderBrush" Value="#30243F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA6B2"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Border CornerRadius="6" BorderBrush="#3A2852" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.Background><SolidColorBrush Color="#141419"/></Grid.Background>
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Margin="22,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#A898CA" Width="28" Height="28" CornerRadius="8"><TextBlock Text="K" Foreground="#130D24" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="KAIDEN" FontSize="13" FontWeight="Bold" Margin="12,0,6,0" VerticalAlignment="Center"/><TextBlock Text="FLUX" FontSize="13" Foreground="#B8A3D7" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="—" Background="Transparent" Padding="15,8"/><Button x:Name="Maximize" Content="□" Background="Transparent" Padding="15,8"/><Button x:Name="CloseApp" Content="✕" Background="Transparent" Padding="15,8"/></StackPanel></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#261D33" BorderThickness="0,0,1,0" Padding="16,24,16,18"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#21182F" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="KAIDEN FLUX" Foreground="#C6B4E1" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Mouse acceleration configuration" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border><Button x:Name="Licenses" Content="Licenses" Background="Transparent" Foreground="#8A7C9E" Padding="10,6"/></StackPanel><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Muted}" Margin="14,0,0,15"/><Button x:Name="NavOverview" Content="◈   Overview" Style="{StaticResource Nav}" Background="#37303F"/><Button x:Name="NavAI" Content=" AI assistant" Style="{StaticResource Nav}"/><Button x:Name="NavLibrary" Content="▤   Curve library" Style="{StaticResource Nav}"/><Button x:Name="NavMouse" Content="◎   Mouse setup" Style="{StaticResource Nav}"/><Border Height="1" Background="#2A2038" Margin="12,22"/><TextBlock x:Name="SidebarMouse" Text="Your setup" FontWeight="SemiBold" Margin="14,0,0,7"/><TextBlock x:Name="SidebarInfo" Text="Complete your setup" Style="{StaticResource Muted}" Margin="14,0,0,0"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1" Margin="30,18,30,20"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Current settings and pending changes." Foreground="#A99ABD" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C2A25" CornerRadius="16" Padding="14,8"><TextBlock x:Name="DriverBadge" Text="●  Checking driver" Foreground="#8DDAB2" FontSize="12"/></Border></Grid>
     <Grid x:Name="Overview" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
      <UniformGrid Columns="3" Margin="0,0,-14,16"><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="MOUSE DPI" Style="{StaticResource Muted}"/><TextBlock x:Name="DpiMetric" Text="1,600" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="POLLING RATE" Style="{StaticResource Muted}"/><TextBlock x:Name="PollMetric" Text="Automatic" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,14,0"><StackPanel><TextBlock Text="CURRENT CURVE" Style="{StaticResource Muted}"/><TextBlock x:Name="CurveMetric" Text="Classic" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
      <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Acceleration curve" FontSize="16" FontWeight="SemiBold"/><Border Background="#322246" CornerRadius="7" Padding="8,4" Margin="12,-2,0,0" VerticalAlignment="Top"><TextBlock x:Name="PreviewTag" Text="LIVE" FontSize="10" Foreground="#C8ADFF"/></Border></StackPanel><Canvas x:Name="CurveCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"/><Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Slow aim" Style="{StaticResource Muted}"/><TextBlock x:Name="CurveAxis" Text="Input speed →" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="Fast flick" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid></Grid></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="ApplyCurve" Content="Apply changes" Style="{StaticResource Primary}" Margin="0,10,0,0"/><Button x:Name="DiscardCurve" Content="Discard preview" Background="Transparent" Padding="12,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Fine tune" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Changes stay in preview until applied." Style="{StaticResource Muted}" Margin="0,5,0,14"/><Grid><TextBlock Text="Base sensitivity"/><TextBlock x:Name="SensValue" HorizontalAlignment="Right" Foreground="#C8ADFF"/></Grid><Slider x:Name="SensSlider" Minimum="0.1" Maximum="3" Value="1" SmallChange="0.05"/><Grid><TextBlock Text="Acceleration"/><TextBlock x:Name="AccelValue" HorizontalAlignment="Right" Foreground="#C8ADFF"/></Grid><Slider x:Name="AccelSlider" Minimum="0" Maximum="1" Value="0.3" SmallChange="0.01"/><Grid><TextBlock Text="Input offset"/><TextBlock x:Name="OffsetValue" HorizontalAlignment="Right" Foreground="#C8ADFF"/></Grid><Slider x:Name="OffsetSlider" Minimum="0" Maximum="20" Value="2" SmallChange="0.25"/><Grid><TextBlock Text="Output cap"/><TextBlock x:Name="CapValue" HorizontalAlignment="Right" Foreground="#C8ADFF"/></Grid><Slider x:Name="CapSlider" Minimum="1" Maximum="5" Value="2" SmallChange="0.1"/></StackPanel></ScrollViewer></DockPanel></Border>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Assisted tuning" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="A more personal feel, one conversation away." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="1" x:Name="OpenAI" Content="Open assistant" VerticalAlignment="Center" Background="#38234F" Padding="14,12"/></Grid></Border>
<Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Curve library" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Save and restore curve configurations." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="QuickSave" Content="Save curve" Padding="14,8"/><Button x:Name="QuickUndo" Content="Undo last apply" Background="Transparent" Padding="10,8"/></StackPanel></Grid></Border></Grid>
     </Grid>
     <Grid x:Name="AIPage" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AI assistant" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Describe the adjustment you need. Review before applying." Style="{StaticResource Muted}" Margin="0,8,0,20"/></StackPanel><ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Messages"/></ScrollViewer><StackPanel Grid.Row="2"><WrapPanel Margin="0,10,0,12"><Button x:Name="SuggestSteady" Content="Steadier aim" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="SuggestFlick" Content="Faster flicks" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="SuggestGentle" Content="Gentler curve" Padding="12,8"/></WrapPanel><TextBox x:Name="ChatInput" AcceptsReturn="True" Height="88" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Margin="0,12,0,0"><TextBlock Text="Your request and tuning context are sent to Google." Style="{StaticResource Muted}" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RetryAI" Content="Retry request" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="CancelAI" Content="Cancel" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="SendAI" Content="Generate proposal" Style="{StaticResource Primary}"/></StackPanel></StackPanel></StackPanel></Grid></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Connect Gemini" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="API key · saved with Windows encryption" Style="{StaticResource Muted}" Margin="0,16,0,8"/><PasswordBox x:Name="ApiKey"/><TextBlock Text="Model ID" Style="{StaticResource Muted}" Margin="0,14,0,8"/><TextBox x:Name="ModelId" Text="gemini-3.5-flash-lite"/><Button x:Name="FastModel" Content="Use fast model" Background="#37303F" Margin="0,10,0,0" Padding="12,9"/><Button x:Name="GetKey" Content="Get a key from Google ↗" Background="Transparent" Foreground="#BFA4F3" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Proposed changes" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ProposalSummary" Text="Your next proposal will appear here. Nothing changes until you apply it." Style="{StaticResource Muted}" Margin="0,12,0,14"/><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ProposalDiff" TextWrapping="Wrap" Foreground="#CCB5F8" FontSize="12"/></ScrollViewer><Button x:Name="ApplyAI" Content="Apply proposal" Style="{StaticResource Primary}" Margin="0,16,0,0" IsEnabled="False"/></StackPanel></Border></StackPanel></Grid>
     <ScrollViewer x:Name="LibraryPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="A starting point for every style." Foreground="#BCAACD" Margin="0,5,0,20"/><UniformGrid Columns="3" Margin="0,0,-14,24"><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="01 / PRECISION" Foreground="#B19AD1" FontSize="11"/><TextBlock Text="Quiet aim" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="A gentle lift with a restrained output cap." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetQuiet" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="02 / EVERYDAY" Foreground="#B19AD1" FontSize="11"/><TextBlock Text="Balanced" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="Measured acceleration for aim and movement." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetBalanced" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="03 / MOTION" Foreground="#B19AD1" FontSize="11"/><TextBlock Text="Flick boost" FontSize="22" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="More reach when you make a fast movement." Style="{StaticResource Muted}" MinHeight="50"/><Button x:Name="PresetFlick" Content="Preview curve" Margin="0,16,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Your saved curves" FontSize="18" FontWeight="SemiBold"/><Button x:Name="SaveLibrary" Content="Save current curve" HorizontalAlignment="Right"/></Grid><StackPanel x:Name="SavedCurves" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="230,0,28,0"><TextBlock x:Name="Status" Text="Ready." Foreground="#9C8BAE" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="KAIDEN FLUX  /  0.3.4" Foreground="#6F5D85" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Border x:Name="WizardOverlay" Grid.RowSpan="3" Background="#0D0917" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Border Margin="58,86,40,70" CornerRadius="26" Padding="40"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B2259" Offset="0"/><GradientStop Color="#1B102B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><StackPanel VerticalAlignment="Top"><TextBlock Text="K / F" Foreground="#C9B0FA" FontSize="18" FontWeight="Bold"/><TextBlock Text="Better aim.&#10;Your way." FontSize="48" FontWeight="SemiBold" Margin="0,54,0,22"/><TextBlock Text="A little setup. A completely personal feel." Foreground="#C3ACD8" FontSize="17" TextWrapping="Wrap"/><Canvas Height="180" Margin="0,30,0,0"><Path Stroke="#C3A0FF" StrokeThickness="4" Data="M 0,155 C 70,155 90,148 140,110 S 230,38 310,20"/><Path Stroke="#664486" StrokeThickness="1" Data="M 0,176 L 310,176 M 0,128 L 310,128 M 0,80 L 310,80 M 0,32 L 310,32"/></Canvas></StackPanel><TextBlock Text="Your setup is saved on this PC.&#10;Change it anytime from Mouse setup." Style="{StaticResource Muted}" VerticalAlignment="Bottom"/></Grid></Border><Grid Grid.Column="1" Margin="42,95,76,90"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions><Grid><TextBlock x:Name="WizardCount" Text="01 / 09" Foreground="#B395DD" FontSize="12"/><Button x:Name="WizardClose" Content="✕" HorizontalAlignment="Right" Background="Transparent" Padding="8,0"/></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="WizardEyebrow" Text="WELCOME TO FLUX" Foreground="#B295D3" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="WizardTitle" Text="Let's get connected." FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="WizardDescription" Text="" Foreground="#AE9BBF" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,26"/><StackPanel x:Name="WizardFields"/><TextBlock x:Name="WizardError" Foreground="#F0A8BA" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel><Grid Grid.Row="2"><Button x:Name="WizardBack" Content="← Back" HorizontalAlignment="Left" Background="Transparent"/><Button x:Name="WizardNext" Content="Continue →" HorizontalAlignment="Right" Style="{StaticResource Primary}"/></Grid></Grid></Grid></Border>
  </Grid>
 </Border>
</Window>
